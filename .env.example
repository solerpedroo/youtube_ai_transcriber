# Copie para .env.local (dev) ou configure no painel da Vercel → Settings → Environment Variables.

# --- Segurança (recomendado em deploy público) ---
# Exige header x-api-access-secret (injete no proxy; a UI não envia).
# API_ACCESS_SECRET=

# Hosts permitidos para baseUrl OpenAI-compatible (separados por vírgula).
# OPENAI_COMPATIBLE_ALLOWED_HOSTS=api.openai.com,openrouter.ai

# Confia em X-Forwarded-For atrás de proxy (rate limit).
# TRUST_PROXY=true

# --- Binários (opcional; padrão usa yt-dlp-exec + ffmpeg-static no serverless) ---
# YTDLP_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=
